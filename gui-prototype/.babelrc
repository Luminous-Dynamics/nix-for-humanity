{
  "presets": [
    ["@babel/preset-env", { 
      "targets": { "node": "current" },
      "modules": false
    }],
    ["@babel/preset-react", { 
      "runtime": "automatic",
      "importSource": "react"
    }],
    ["@babel/preset-typescript", {
      "isTSX": true,
      "allExtensions": true
    }]
  ],
  "plugins": [],
  "env": {
    "test": {
      "presets": [
        ["@babel/preset-env", { 
          "targets": { "node": "current" }
        }],
        ["@babel/preset-react", { 
          "runtime": "automatic",
          "importSource": "react"
        }],
        ["@babel/preset-typescript", {
          "isTSX": true,
          "allExtensions": true
        }]
      ]
    }
  }
}