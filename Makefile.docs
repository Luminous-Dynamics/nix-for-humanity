# Documentation Makefile for Luminous Nix
.PHONY: help docs serve build deploy clean

help:
	@echo "Luminous Nix Documentation Commands:"
	@echo "  make docs-serve  - Start local documentation server"
	@echo "  make docs-build  - Build static documentation"
	@echo "  make docs-deploy - Deploy to GitHub Pages"
	@echo "  make docs-clean  - Clean built documentation"

docs-serve:
	@echo "Starting documentation server at http://localhost:8000"
	@echo "Press Ctrl+C to stop"
	poetry run mkdocs serve

docs-build:
	@echo "Building documentation..."
	poetry run mkdocs build

docs-deploy:
	@echo "Deploying to GitHub Pages..."
	poetry run mkdocs gh-deploy --force

docs-clean:
	@echo "Cleaning documentation build..."
	rm -rf site/

docs-new-version:
	@echo "Creating new version of docs..."
	poetry run mike deploy --push --update-aliases $(version) latest

docs-test:
	@echo "Testing documentation build..."
	poetry run mkdocs build --strict