#!/usr/bin/env python3
"""
🌊 Luminous Nix - Clean Architecture Edition

This is the refactored CLI with proper configuration management.
No more environment variables, clear flag precedence, consistent naming.
"""

import sys
from pathlib import Path

# Add src to path
src_path = Path(__file__).parent.parent / "src"
sys.path.insert(0, str(src_path))

from luminous_nix.core.backend_real import RealNixBackend
from luminous_nix.core.config import load_config
from luminous_nix.core.intents import IntentRecognizer


def main():
    """Main entry point with clean configuration"""
    # Load configuration with proper precedence
    config = load_config(sys.argv[1:])

    # Get the command from parsed args
    if hasattr(config, "_command"):
        command = " ".join(config._command)
    else:
        command = None

    # Show help if no command
    if not command:
        print_help(config)
        return 0

    # Show configuration in verbose mode
    if config.verbose > 0:
        print("🔧 Configuration:")
        print(f"  Mode: {config.get_display_mode()}")
        print(f"  Verbosity: {config.get_verbosity_level()}")
        if config.force:
            print("  Confirmations: Skipped")
        print()

    # Create backend with config
    backend = RealNixBackend(config)

    # Recognize intent
    recognizer = IntentRecognizer()
    intent = recognizer.recognize(command)

    # Process the intent
    if config.verbose > 0:
        print(f"🎯 Intent: {intent.type.value}")
        print("🔄 Processing...")
        print()

    response = backend.process(intent)

    # Display response with proper formatting
    if response.success:
        icon = "🔍" if config.preview else "✅"
        if config.icons:
            print(f"{icon} {response.text}")
        else:
            print(response.text)
    else:
        if config.icons:
            print(f"❌ {response.text}")
        else:
            print(f"ERROR: {response.text}")

    # Show additional data in verbose mode
    if config.verbose > 0 and response.data:
        print("\n📊 Details:")
        for key, value in response.data.items():
            if isinstance(value, list) and len(value) > 10:
                print(f"  {key}: {len(value)} items")
            else:
                print(f"  {key}: {value}")

    return 0 if response.success else 1


def print_help(config):
    """Print help message"""
    mode_desc = "preview" if config.preview else "apply"

    print(
        f"""
Luminous Nix v0.1.0-alpha - Natural Language NixOS Interface

USAGE:
    ask-nix <command> [options]

COMMANDS:
    search <package>    Search for packages
    install <package>   Install a package
    remove <package>    Remove a package
    list               List installed packages
    info [package]     Show package or system info
    help              Show this help

MODE OPTIONS:
    --preview, -p      Preview changes without applying (default)
    --apply, -a        Apply changes to the system

CONFIRMATION:
    --yes, -y          Skip all confirmation prompts

OUTPUT:
    --verbose, -v      Increase verbosity (-vv for debug)
    --quiet, -q        Minimal output
    --no-color         Disable colored output
    --no-icons         Disable unicode icons

EXAMPLES:
    ask-nix search firefox                # Search packages
    ask-nix install vim --preview         # Preview installation
    ask-nix install vim --apply           # Actually install
    ask-nix remove vim --apply --yes      # Remove without confirmation
    ask-nix list                          # List installed packages

CURRENT MODE: {config.get_display_mode()}
    """
    )


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)
