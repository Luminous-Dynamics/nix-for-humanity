{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Luminous Nix Plugin Manifest",
  "description": "Schema for consciousness-first plugin validation",
  "type": "object",
  "required": ["name", "version", "description", "governing_principle"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 3,
      "maxLength": 50
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "governing_principle": {
      "type": "string",
      "enum": [
        "Resonant Coherence",
        "Pan-Sentient Flourishing",
        "Integral Wisdom",
        "Infinite Play",
        "Universal Interconnectedness",
        "Sacred Reciprocity",
        "Evolutionary Progression"
      ]
    },
    "author": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "entry_point": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*\\.py$"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["read", "write", "execute", "network", "system"]
      }
    },
    "consciousness_level": {
      "type": "string",
      "enum": ["nascent", "emerging", "coherent", "unified", "transcendent"]
    }
  }
}
